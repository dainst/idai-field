<header class="px-4 sm:px-6 lg:px-8 h-(--main-navbar-height)">
  <div class="flex items-center justify-between border-b border-zinc-100 text-sm">
    <.link class="flex items-center gap-4 text-primary hover:text-primary-hover" navigate={~p"/"}>
      <img src={Settings.get_logo_url()} class="h-12" />
      <p class="px-4 font-medium leading-6">
        {Settings.get_page_name()} v{Application.spec(:field_publication, :vsn)}
      </p>
    </.link>
    <div class="relative">
      <div class="lg:hidden">
        <a phx-click={JS.toggle(to: "#menu")}><.icon name="hero-bars-3" /></a>
      </div>
      <div class="hidden lg:block absolute lg:relative right-0 z-10" id="menu">
        <div class="flex flex-col bg-panel p-1 lg:flex-row gap-4 text-nowrap lg:bg-white">
          <%= if @current_user do %>
            <span>
              {@current_user}
            </span>
            <.link navigate="/management">
              Management
            </.link>
            <.link href={~p"/log_out"} method="delete">
              Log out
            </.link>
          <% else %>
            <.link href={~p"/log_in"}>
              Log in
            </.link>
          <% end %>

          <div>
            <form action={~p"/select_locale"} id="locale_form">
              <.icon name="hero-globe-alt" class="h-4 w-4" />
              <select
                name="locale"
                id="locale-select"
                phx-change={JS.dispatch("click", to: "#submit_language_selection")}
              >
                <%= for lang <- FieldPublicationWeb.Translate.supported_languages() do %>
                  <option
                    value={lang}
                    selected={Gettext.get_locale(FieldPublicationWeb.Translate) == lang}
                  >
                    {Map.get(FieldPublicationWeb.Translate.get_locale_labels(), lang, lang)}
                  </option>
                <% end %>
              </select>
              <input type="hidden" name="return_to" value={@current_path} />
              <button class="hidden" id="submit_language_selection"></button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
<main class="mx-auto  h-full w-full pb-24 pt-2 px-4 sm:px-6 lg:px-8">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
<footer class="w-full flex gap-2 absolute h-16 bottom-0 justify-center border-t pt-2">
  <.link navigate={~p"/contact"}>Contact</.link>
  | <a target="_blank" href="https://github.com/dainst/idai-field">The Field software system</a>
</footer>
