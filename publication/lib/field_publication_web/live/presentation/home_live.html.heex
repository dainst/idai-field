<%= if @published_projects == [] do %>
  <div :if={User.is_admin?(@current_user)}>
    {gettext_with_link(
      "Go to %{link_start}management%{link_end} to setup projects, add editors and prepare first associated publications.",
      link: [navigate: ~p"/management"]
    )}
  </div>
  <div :if={@current_user && !User.is_admin?(@current_user)}>
    {gettext_with_link(
      "Go to %{link_start}management%{link_end} to manage publications for your project(s).",
      link: [navigate: ~p"/management"]
    )}
  </div>
  <div :if={is_nil(@current_user)}>{gettext("No data published yet")}</div>
<% else %>
  <.document_heading>{gettext("home_title")}</.document_heading>
  <div class="flex flex-col-reverse lg:flex-row">
    <div class="mt-4 lg:mt-0 lg:basis-1/3 mr-2">
      <div>
        <.link navigate={~p"/search"}>{gettext("Search all projects")}</.link>
        <%= for %{doc: doc} = project <- @published_projects do %>
          <div
            id={"project_list_#{project[:name]}"}
            phx-hook="HoverHighlightMapFeature"
            target_dom_element="project_overview_map"
            target_id={project[:name]}
          >
            <!-- The custom hook above triggers the marker highlight on the map component below when hovering this element. -->
            <!-- In parallel to the hook above, phx-click and phx-value-* below implement the click behaviour
              with standard liveview attributes. -->
            <.link navigate={~p"/projects/#{project[:name]}"}>
              <div
                class={"rounded #{if @highlighted == project[:name] do "bg-primary-hover text-primary-inverse-hover" else "bg-primary text-primary-inverse" end}  p-2 mt-2 cursor-pointer"}
                phx-value-id={project[:name]}
              >
                <div class="text-center">
                  <%= case Document.get_field_value(doc, "shortName") do %>
                    <% val when is_map(val) -> %>
                      {pick_default_translation(val)}
                    <% val when is_binary(val) -> %>
                      {val}
                    <% _ -> %>
                      {project[:name]}
                  <% end %>
                </div>
              </div>
            </.link>
          </div>
        <% end %>
      </div>
    </div>

    <div class="lg:basis-2/3">
      <.live_component
        module={FieldPublicationWeb.Components.WorldMap}
        id="project_overview_map"
        style="width:100%; height:var(--ol-full-height);"
        projects={@published_projects}
      />
    </div>
  </div>
<% end %>
